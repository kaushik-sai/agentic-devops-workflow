{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(CODEOWNERS)",
      "Write(CODEOWNERS)",
      "Edit(modules/AgentFlow/**)",
      "Write(modules/AgentFlow/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(tests/AgentFlow/**)",
      "Write(tests/AgentFlow/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
